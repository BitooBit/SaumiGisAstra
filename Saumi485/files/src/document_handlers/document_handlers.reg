[HKEY_CLASSES_ROOT\SAUMI.xls\DefaultIcon]
@="C:\\SAUMI\\filetypes\\xls.ico"

[HKEY_CLASSES_ROOT\.xlsx]
@="SAUMI.xlsx"

[HKEY_CLASSES_ROOT\.xlsx\DefaultIcon]
@="C:\\SAUMI\\filetypes\\xls.ico"

